{
  "name": "openapply-agent",
  "version": "0.1.0",
  "description": "A privacy-first, human-in-the-loop job discovery and application workflow.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "browser:discover": "tsx src/browser/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@napi-rs/keyring": "^2.1.2",
    "playwright": "^1.65.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
