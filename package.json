{
  "name": "openapply-agent",
  "version": "0.1.0",
  "description": "A privacy-first, human-in-the-loop job discovery and application workflow.",
  "bin": { "openapply": "dist/src/product-cli.js" },
  "files": ["dist/src", "templates", "examples", "docs", "README.md", "LICENSE"],
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "browser:discover": "tsx src/browser/cli.ts",
    "browser:open": "tsx src/browser/open-cli.ts",
    "browser:install": "playwright install chromium",
    "browser:doctor": "tsx src/browser/doctor-cli.ts",
    "browser:benchmark": "tsx src/browser/benchmark-cli.ts",
    "application:run": "tsx src/application/cli.ts",
    "application:status": "tsx src/application/status-cli.ts",
    "handoff:ui": "tsx src/application/handoff-ui-cli.ts",
    "state:cutover": "tsx src/storage/sqlite-cutover-cli.ts",
    "state:control": "tsx src/storage/data-controls-cli.ts",
    "queue:run": "tsx src/application/queue-cli.ts",
    "autopilot": "tsx src/application/autopilot-cli.ts",
    "profile:compile": "tsx src/candidate/markdown-cli.ts",
    "setup:init": "tsx src/setup/init-cli.ts",
    "setup:ui": "tsx src/setup/ui-cli.ts",
    "secret:put": "tsx src/auth/secret-put-cli.ts",
    "oauth:connect": "tsx src/auth/oauth-connect-cli.ts",
    "schedule:install": "tsx src/scheduler/cli.ts install",
    "schedule:remove": "tsx src/scheduler/cli.ts remove",
    "resume:render": "tsx src/resume/cli.ts",
    "build": "tsc -p tsconfig.json",
    "distribution:smoke": "node --test scripts/assert-package.test.mjs && node scripts/smoke-portable-package.mjs",
    "distribution:staging-smoke": "node --test scripts/staging-user-install.test.mjs",
    "distribution:staging": "node scripts/staging-user-install.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@napi-rs/canvas": "^1.2.0",
    "@napi-rs/keyring": "^2.1.2",
    "htmlparser2": "^12.0.0",
    "pdfjs-dist": "^6.5.438",
    "playwright": "^1.65.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
