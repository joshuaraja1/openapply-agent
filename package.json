{
  "name": "openapply-agent",
  "version": "0.1.0",
  "description": "A privacy-first, human-in-the-loop job discovery and application workflow.",
  "bin": { "openapply": "dist/src/product-cli.js" },
  "files": ["dist/src", "templates", "examples", "docs", "README.md", "LICENSE", "runtime-package-lock.json"],
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "browser:discover": "tsx src/browser/cli.ts",
    "browser:open": "tsx src/browser/open-cli.ts",
    "browser:install": "playwright install chromium",
    "browser:doctor": "tsx src/browser/doctor-cli.ts",
    "browser:benchmark": "tsx src/browser/benchmark-cli.ts",
    "queue:benchmark": "node scripts/benchmark-queue.mjs",
    "application:benchmark": "node scripts/benchmark-application-stage.mjs",
    "application:run": "tsx src/application/cli.ts",
    "application:status": "tsx src/application/status-cli.ts",
    "application:review": "tsx src/application/uncertain-review-cli.ts",
    "application:verify-owned": "tsx src/application/owned-confirm-cli.ts",
    "handoff:ui": "tsx src/application/handoff-ui-cli.ts",
    "state:cutover": "tsx src/storage/sqlite-cutover-cli.ts",
    "state:control": "tsx src/storage/data-controls-cli.ts",
    "beta:evidence": "tsx src/application/beta-evidence-cli.ts",
    "queue:run": "tsx src/application/queue-cli.ts",
    "autopilot": "tsx src/application/autopilot-cli.ts",
    "profile:compile": "tsx src/candidate/markdown-cli.ts",
    "setup:init": "tsx src/setup/init-cli.ts",
    "setup:ui": "tsx src/setup/ui-cli.ts",
    "secret:put": "tsx src/auth/secret-put-cli.ts",
    "oauth:connect": "tsx src/auth/oauth-connect-cli.ts",
    "oauth:doctor": "tsx src/auth/oauth-doctor-cli.ts",
    "schedule:install": "tsx src/scheduler/cli.ts install",
    "schedule:remove": "tsx src/scheduler/cli.ts remove",
    "resume:render": "tsx src/resume/cli.ts",
    "resume:review": "tsx src/resume/review-cli.ts",
    "build": "tsc -p tsconfig.json",
    "build:hosted-lambda": "esbuild src/hosted/aws-billing-lambda.ts --bundle --platform=node --target=node22 --format=cjs --packages=bundle --outfile=dist-hosted/aws-billing-lambda.cjs",
    "distribution:smoke": "node --test scripts/assert-package.test.mjs && node scripts/smoke-portable-package.mjs",
    "distribution:staging-smoke": "node --test scripts/staging-user-install.test.mjs",
    "distribution:release-gate-smoke": "node --test scripts/verify-release-bundle.test.mjs",
    "distribution:macos-pkg-smoke": "node --test scripts/build-macos-pkg.test.mjs",
    "distribution:macos-pkg": "node scripts/build-macos-pkg.mjs",
    "distribution:verified-stage-smoke": "node --test scripts/stage-verified-bundle.test.mjs",
    "distribution:verified-stage": "node scripts/stage-verified-bundle.mjs",
    "distribution:verify-release": "node scripts/verify-release-bundle.mjs",
    "distribution:staging": "node scripts/staging-user-install.mjs",
    "distribution:locked-smoke": "node --test scripts/locked-tarball-install.test.mjs",
    "distribution:locked-install": "node scripts/locked-tarball-install.mjs",
    "prepack": "npm run build && node scripts/pack-runtime-lock.mjs prepare",
    "postpack": "node scripts/pack-runtime-lock.mjs remove",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && node --test scripts/stripe-sandbox-smoke.test.mjs && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1178.0",
    "@aws-sdk/client-kms": "^3.1178.0",
    "@aws-sdk/client-s3": "^3.1178.0",
    "@aws-sdk/client-secrets-manager": "^3.1178.0",
    "@aws-sdk/lib-dynamodb": "^3.1178.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@napi-rs/canvas": "^1.2.0",
    "@napi-rs/keyring": "^2.1.2",
    "htmlparser2": "^12.0.0",
    "jose": "^6.2.18",
    "pdfjs-dist": "^6.5.438",
    "playwright": "^1.65.1",
    "stripe": "^23.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "^0.28.2",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
