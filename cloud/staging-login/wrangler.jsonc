{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "openapply-staging-login",
  "main": "./worker.mjs",
  "compatibility_date": "2026-11-26",
  "workers_dev": true,
  "routes": [{ "pattern": "staging.openapplyagent.xyz", "custom_domain": true }],
  "observability": { "enabled": false, "traces": { "enabled": false } },
  "assets": {
    "directory": "../staging-login-dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
