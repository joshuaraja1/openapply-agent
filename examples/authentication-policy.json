{
  "version": 1,
  "browserProfile": {
    "strategy": "dedicated-profile",
    "sourceBrowser": "none",
    "importCookies": false,
    "importPasswords": false,
    "persistSessions": true,
    "requireInteractiveConsent": true
  },
  "accounts": [
    {
      "id": "job-search",
      "email": "candidate@example.com",
      "domains": ["example.wd5.myworkdayjobs.com"],
      "passwordSecretRef": "keychain://openapply/job-search",
      "allowAccountCreation": false
    }
  ],
  "emailVerification": {
    "enabled": false,
    "allowedSenderDomains": [],
    "maximumMessageAgeSeconds": 300,
    "autoEnter": false
  }
}
